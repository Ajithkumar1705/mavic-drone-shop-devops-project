# Local development secrets. Copy to .env and replace every value before use.
# .env is ignored by Git and must never be committed.

MYSQL_PASSWORD=replace-with-a-strong-local-password
APP_SECRET=replace-with-a-long-random-application-secret
RABBITMQ_USER=replace-with-a-local-user
RABBITMQ_PASSWORD=replace-with-a-strong-local-password

SEED_USER_NAME=demo-user
SEED_USER_PASSWORD=replace-with-a-strong-local-password
SEED_USER_EMAIL=demo-user@example.invalid
SEED_STAN_NAME=demo-stan
SEED_STAN_PASSWORD=replace-with-a-strong-local-password
SEED_STAN_EMAIL=demo-stan@example.invalid
SEED_PARTNER_NAME=demo-partner
SEED_PARTNER_PASSWORD=replace-with-a-strong-local-password
SEED_PARTNER_EMAIL=demo-partner@example.invalid

LOAD_TEST_USERNAME=demo-user
LOAD_TEST_PASSWORD=replace-with-the-seed-user-password
