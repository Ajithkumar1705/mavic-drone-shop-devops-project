aws_region      = "ap-south-1"
environment     = "dev"
cluster_name    = "mavic-drone-shop-eks"
cluster_version = "1.35"

vpc_cidr           = "10.0.0.0/16"
availability_zones = ["ap-south-1a", "ap-south-1b"]

node_instance_type = "m7i-flex.large"
node_desired_size  = 2
node_min_size      = 1
node_max_size      = 3

github_actions_user_name = "replace-with-your-ci-iam-user"
# Set securely through TF_VAR_grafana_admin_password instead of committing it here.
